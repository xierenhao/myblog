---
import { renderCoverSVG } from '../lib/cover';

interface CoverPost {
  data: {
    title: string;
    category: 'ai' | 'football' | 'fragments';
    coverKeyword?: string;
    coverData?: number[];
    coverMultiline?: number[][];
    coverMotif?: 'loop' | 'viewfinder' | 'strata' | 'curve' | 'multiline' | 'weeknum' | 'keyword' | 'firstChar';
    coverWeek?: number;
  };
}

interface Props {
  post: CoverPost;
  size?: 'sm' | 'lg';
}

const { post, size = 'sm' } = Astro.props;
const isLg = size === 'lg';
const coverClass = `cover cover-${isLg ? 'lg' : 'sm'}`;

const palettes = {
  ai: 'AI',
  football: '足球',
  fragments: '碎片',
};
const label = palettes[post.data.category] || '';

const svg = renderCoverSVG(post.data, size);
---

<div class={coverClass}>
  <Fragment set:html={svg} />
  <span class="cover-label">{label}</span>
</div>
