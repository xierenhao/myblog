---
import ArticleCover from './ArticleCover.astro';

interface Post {
  slug: string;
  data: {
    title: string;
    date: Date;
    category: 'ai' | 'football' | 'fragments';
    excerpt: string;
    coverKeyword?: string;
    coverData?: number[];
    coverDiagram?: string;
  };
}

const { post } = Astro.props as { post: Post };

const dateStr = post.data.date.toLocaleDateString('zh-CN', {
  month: '2-digit',
  day: '2-digit',
}).replace(/\//g, '.');
---

<a href={`/posts/${post.slug}`} class="article-row-link">
  <article class="article-row">
    <ArticleCover post={post} size="sm" />
    <div class="article-row-copy">
      <h4>{post.data.title}</h4>
      <p>{post.data.excerpt}</p>
    </div>
    <time>{dateStr}</time>
  </article>
</a>
