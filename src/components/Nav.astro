---
interface Props {
  activeNav?: string;
}

const { activeNav = '/' } = Astro.props;

const navItems = [
  { label: '首页', href: '/' },
  { label: '全部文章', href: '/articles' },
  { label: 'AI', href: '/ai' },
  { label: '足球', href: '/football' },
  { label: '碎片', href: '/fragments' },
  { label: '合辑', href: '/collections' },
  { label: '关于', href: '/about' },
];
---

<header class="blog-header">
  <a href="/" class="wordmark" aria-label="Bruce Xie Blog 首页">
    <strong>Bruce Xie</strong>
    <span>BLOG</span>
  </a>
  <div class="header-actions">
    <nav class="blog-nav" aria-label="Blog 导航">
      {navItems.map((item) => (
        <a href={item.href} class={activeNav === item.href ? 'active' : ''}>
          {item.label}
        </a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="切换主题" id="theme-toggle">
      <span class="theme-icon-light">☀</span>
      <span class="theme-icon-dark">☾</span>
    </button>
  </div>
</header>

<style>
  .theme-icon-dark { display: none; }
  .theme-icon-light { display: inline; }
  [data-theme="dark"] .theme-icon-dark { display: inline; }
  [data-theme="dark"] .theme-icon-light { display: none; }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    document.documentElement.style.colorScheme = next;
    try { localStorage.setItem('bruce-xie-blog-theme', next); } catch (e) {}
  });
</script>
