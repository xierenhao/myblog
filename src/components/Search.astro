---
---

<div id="search-overlay" class="search-overlay" aria-hidden="true">
  <div class="search-panel">
    <div class="search-input-row">
      <span class="search-icon" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="1.2">
          <circle cx="7" cy="7" r="4.5" />
          <line x1="10.5" y1="10.5" x2="14" y2="14" stroke-linecap="round" />
        </svg>
      </span>
      <input id="search-input" type="text" placeholder="搜索文章…" autocomplete="off" spellcheck="false" />
      <button class="search-esc" type="button" id="search-esc">ESC</button>
    </div>
    <div id="search-results" class="search-results"></div>
  </div>
</div>

<style is:global>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    display: none;
    z-index: 1000;
  }

  .search-overlay.open {
    display: block;
  }

  .search-panel {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    width: 100%;
    max-height: 70vh;
    overflow: auto;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .search-input-row {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    width: min(var(--shell-width), 100% - calc(var(--shell-padding) * 2));
    margin: 0 auto;
  }

  .search-icon {
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .search-icon svg {
    display: block;
  }

  #search-input {
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--ink);
    padding: 4px 0;
    width: 100%;
  }

  #search-input::placeholder {
    color: var(--muted);
  }

  .search-esc {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 11px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .search-esc:hover {
    border-color: var(--muted);
    color: var(--ink);
  }

  .search-results {
    width: min(var(--shell-width), 100% - calc(var(--shell-padding) * 2));
    margin: 0 auto;
    padding: 4px 0 8px;
  }

  .search-results .article-row-link:last-child {
    border-bottom: none;
  }

  .search-view-all {
    display: block;
    padding: 14px 0 6px;
    font-family: var(--font-serif);
    font-size: 12px;
    color: var(--muted);
    text-align: center;
    transition: color 0.15s;
  }

  .search-view-all:hover {
    color: var(--ink);
  }

  .search-empty-inline {
    padding: 24px 0;
    font-family: var(--font-serif);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  .search-empty-inline em {
    font-style: italic;
    color: var(--ink);
  }
</style>

<script>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const escBtn = document.getElementById('search-esc');
  const results = document.getElementById('search-results');
  const trigger = document.getElementById('search-trigger');

  let index: any[] = [];

  async function loadIndex() {
    if (index.length > 0) return index;
    const res = await fetch('/search-index.json');
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    index = await res.json();
    return index;
  }

  function escHtml(s: string) {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  const categoryLabels: Record<string, string> = {
    ai: 'AI',
    football: '足球',
    fragments: '碎片',
  };

  function parseQuery(raw: string): { include: string[]; exclude: string[] } {
    const tokens: string[] = [];
    let cur = '';
    let inQuote = false;
    for (let i = 0; i < raw.length; i++) {
      const c = raw[i];
      if (c === '"') { inQuote = !inQuote; continue; }
      if (c === ' ' && !inQuote) {
        if (cur) tokens.push(cur);
        cur = '';
      } else {
        cur += c;
      }
    }
    if (cur) tokens.push(cur);

    const include: string[] = [];
    const exclude: string[] = [];
    for (const t of tokens) {
      if (t.startsWith('-') && t.length > 1) exclude.push(t.slice(1).toLowerCase());
      else include.push(t.toLowerCase());
    }
    return { include, exclude };
  }

  function matchScore(post: any, q: { include: string[]; exclude: string[] }): number {
    const haystack = `${post.title} ${post.excerpt} ${post.content} ${post.category}`.toLowerCase();
    for (const e of q.exclude) {
      if (haystack.includes(e)) return 0;
    }
    let score = 0;
    let titleMatched = false;
    for (const term of q.include) {
      if (!term) continue;
      const idx = haystack.indexOf(term);
      if (idx === -1) return 0;
      score += 10;
      if (post.title.toLowerCase().includes(term)) {
        score += 20;
        titleMatched = true;
      }
      if (post.title.toLowerCase().indexOf(term) === 0) score += 10;
    }
    if (titleMatched) score += 5;
    return score;
  }

  function renderResults(q: string) {
    if (!results) return;
    const trimmed = q.trim();
    if (!trimmed) {
      results.innerHTML = '';
      return;
    }
    const parsed = parseQuery(trimmed);
    if (parsed.include.length === 0 && parsed.exclude.length === 0) {
      results.innerHTML = '';
      return;
    }

    const matched = index
      .map((p) => ({ post: p, score: matchScore(p, parsed) }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 5);

    if (matched.length === 0) {
      results.innerHTML = `<div class="search-empty-inline">没有找到匹配 <em>"${escHtml(trimmed)}"</em> 的文章</div>`;
      return;
    }

    const html = matched.map(({ post }) => {
      const catLabel = categoryLabels[post.category] || post.category;
      return `<a href="/posts/${escHtml(post.slug)}" class="article-row-link">
        <article class="article-row">
          <div class="cover cover-sm">
            ${post.coverSvg}
            <span class="cover-label">${escHtml(catLabel)}</span>
          </div>
          <div class="article-row-copy">
            <h4>${escHtml(post.title)}</h4>
            <p>${escHtml(post.excerpt)}</p>
          </div>
          <time>${escHtml(post.dateShort)}</time>
        </article>
      </a>`;
    }).join('');

    results.innerHTML = html + `<a href="/search?q=${encodeURIComponent(trimmed)}" class="search-view-all">查看全部结果 →</a>`;
  }

  function openOverlay() {
    loadIndex().catch(e => console.error('Search index load error:', e));
    if (!overlay || !input) return;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input.focus(), 50);
  }

  function closeOverlay() {
    if (!overlay || !input) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    input.value = '';
    if (results) results.innerHTML = '';
  }

  trigger?.addEventListener('click', openOverlay);
  escBtn?.addEventListener('click', closeOverlay);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeOverlay();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay?.classList.contains('open')) closeOverlay();
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      if (overlay?.classList.contains('open')) closeOverlay();
      else openOverlay();
    }
    if (e.key === '/' && !overlay?.classList.contains('open') &&
        document.activeElement?.tagName !== 'INPUT' &&
        document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      openOverlay();
    }
  });

  let timer: number | null = null;
  input?.addEventListener('input', () => {
    if (timer) window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      renderResults(input.value);
    }, 80);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const q = input.value.trim();
      if (q) {
        closeOverlay();
        window.location.href = `/search?q=${encodeURIComponent(q)}`;
      }
    }
  });
</script>
