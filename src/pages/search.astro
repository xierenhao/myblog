---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索 · Bruce Xie Blog" activeNav="">
  <section class="home-intro">
    <h1>搜索结果</h1>
    <p id="search-query-display" class="search-query-display"></p>
  </section>

  <section class="full-width">
    <div class="section-heading">
      <h2 id="search-count"></h2>
    </div>
    <div id="search-results-list" class="article-list"></div>
  </section>
</BaseLayout>

<style>
  .search-query-display {
    font-family: var(--font-serif);
    font-size: 13px;
    color: var(--muted);
    margin-top: 8px;
  }
  .search-query-display em {
    font-style: italic;
    color: var(--ink);
  }
  .search-empty-text {
    padding: 32px 0;
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }
</style>

<script>
  async function runSearch() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q') || '';
    const queryDisplay = document.getElementById('search-query-display');
    const countEl = document.getElementById('search-count');
    const listEl = document.getElementById('search-results-list');

    if (!q.trim()) {
      queryDisplay.innerHTML = '请输入搜索关键词';
      countEl.textContent = '';
      listEl.innerHTML = '';
      return;
    }

    queryDisplay.innerHTML = `关键词：<em>"${escapeHtml(q)}"</em>`;
    countEl.textContent = '搜索中...';

    try {
      const res = await fetch('/search-index.json');
      const index = await res.json();
      const parsed = parseQuery(q);
      const matched = index
        .map((p) => ({ post: p, score: matchScore(p, parsed) }))
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score);

      countEl.textContent = `${matched.length} 篇文章`;

      if (matched.length === 0) {
        listEl.innerHTML = `<div class="search-empty-text">没有找到匹配 "${escapeHtml(q)}" 的文章</div>`;
        return;
      }

      listEl.innerHTML = matched.map(({ post }) => `
        <a href="/posts/${escapeHtml(post.slug)}" class="article-row-link">
          <article class="article-row">
            <div class="cover cover-sm">
              ${post.coverSvg}
              <span class="cover-label">${escapeHtml(categoryLabel(post.category))}</span>
            </div>
            <div class="article-row-copy">
              <h4>${escapeHtml(post.title)}</h4>
              <p>${escapeHtml(post.excerpt)}</p>
            </div>
            <time>${escapeHtml(post.dateShort)}</time>
          </article>
        </a>
      `).join('');
    } catch (e) {
      countEl.textContent = '搜索出错';
      listEl.innerHTML = '';
    }
  }

  function categoryLabel(c) {
    return { ai: 'AI', football: '足球', fragments: '碎片' }[c] || c;
  }

  function escapeHtml(s) {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function parseQuery(raw) {
    const tokens = [];
    let cur = '';
    let inQuote = false;
    for (let i = 0; i < raw.length; i++) {
      const c = raw[i];
      if (c === '"') { inQuote = !inQuote; continue; }
      if (c === ' ' && !inQuote) {
        if (cur) tokens.push(cur);
        cur = '';
      } else {
        cur += c;
      }
    }
    if (cur) tokens.push(cur);

    const include = [];
    const exclude = [];
    for (const t of tokens) {
      if (t.startsWith('-') && t.length > 1) exclude.push(t.slice(1).toLowerCase());
      else include.push(t.toLowerCase());
    }
    return { include, exclude };
  }

  function matchScore(post, q) {
    const haystack = `${post.title} ${post.excerpt} ${post.content} ${post.category}`.toLowerCase();
    for (const e of q.exclude) {
      if (haystack.includes(e)) return 0;
    }
    let score = 0;
    let titleMatched = false;
    for (const term of q.include) {
      if (!term) continue;
      const idx = haystack.indexOf(term);
      if (idx === -1) return 0;
      score += 10;
      if (post.title.toLowerCase().includes(term)) {
        score += 20;
        titleMatched = true;
      }
      if (post.title.toLowerCase().indexOf(term) === 0) score += 10;
    }
    if (titleMatched) score += 5;
    return score;
  }

  runSearch();
</script>
