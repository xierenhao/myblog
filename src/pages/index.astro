---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import ArticleRow from '../components/ArticleRow.astro';
import CollectionsSidebar from '../components/CollectionsSidebar.astro';

const allPosts = await getCollection('posts');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const leadPost = sorted[0];
const recentPosts = sorted.slice(1, 6);
---

<BaseLayout title="虾兵xie讲" activeNav="/">
  <section class="home-intro">
    <h1>研究并实践 AI 如何重塑产品与工作方式，业余球员。</h1>
  </section>

  <section>
    <div class="section-heading">
      <h2>从这里开始</h2>
      <a href="/articles">阅读路径 →</a>
    </div>
    {leadPost && <LeadStory post={leadPost} />}
  </section>

  <div class="content-grid">
    <section>
      <div class="section-heading">
        <h2>最新文章</h2>
        <a href="/articles">查看全部 →</a>
      </div>
      <div class="article-list">
        {recentPosts.map((post) => <ArticleRow post={post} />)}
      </div>
    </section>
    <CollectionsSidebar />
  </div>
</BaseLayout>
