---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRow from '../components/ArticleRow.astro';

const allPosts = await getCollection('posts');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="全部文章 · 虾兵xie讲" activeNav="/articles">
  <section class="home-intro">
    <h1>全部文章</h1>
  </section>

  <section class="full-width">
    <div class="section-heading">
      <h2>{sorted.length} 篇文章</h2>
    </div>
    <div class="article-list">
      {sorted.map((post) => <ArticleRow post={post} />)}
    </div>
  </section>
</BaseLayout>
