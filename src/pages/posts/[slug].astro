---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import { getCollectionBySlug } from '../../data/collections';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, date, category, excerpt, subtitle, series, seriesOrder } = post.data;

const allPosts = await getCollection('posts');

const categoryColors = {
  ai: '#18c7b7',
  football: '#f06455',
  fragments: '#e7b844',
};

const categoryLabels = {
  ai: 'AI',
  football: '足球',
  fragments: '碎片',
};

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const seriesText = series
  ? `${series} 第${['一', '二', '三', '四', '五', '六', '七', '八', '九', '十'][seriesOrder - 1] || seriesOrder}篇`
  : '';

// Word count + reading time (Chinese: ~350 chars/min)
const stripped = (post.body || '')
  .replace(/^---[\s\S]+?---/, '')
  .replace(/```[\s\S]+?```/g, ' ')
  .replace(/`[^`]+`/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/[#>*_~|\-]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const chineseChars = (stripped.match(/[\u4e00-\u9fa5]/g) || []).length;
const otherTokens = (stripped.match(/[a-zA-Z0-9]+/g) || []).length;
const wordCount = chineseChars + otherTokens;
const readingTime = Math.max(1, Math.round(wordCount / 350));

// Determine prev/next
let prevPost = null;
let nextPost = null;

if (post.data.collection) {
  // Navigate within collection by collectionOrder
  const collectionPosts = allPosts
    .filter((p) => p.data.collection === post.data.collection)
    .sort((a, b) => (a.data.collectionOrder || 0) - (b.data.collectionOrder || 0));
  const currentIndex = collectionPosts.findIndex((p) => p.slug === post.slug);
  if (currentIndex > 0) prevPost = collectionPosts[currentIndex - 1];
  if (currentIndex < collectionPosts.length - 1) nextPost = collectionPosts[currentIndex + 1];
} else {
  // Navigate within same category by date
  const categoryPosts = allPosts
    .filter((p) => p.data.category === category && !p.data.collection)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const currentIndex = categoryPosts.findIndex((p) => p.slug === post.slug);
  if (currentIndex > 0) prevPost = categoryPosts[currentIndex - 1];
  if (currentIndex < categoryPosts.length - 1) nextPost = categoryPosts[currentIndex + 1];
}

const collectionInfo = post.data.collection ? getCollectionBySlug(post.data.collection) : null;
---

<BaseLayout title={`${title} · 虾兵xie讲`} activeNav={`/${category}`}>
  <article class="post-article">
    <nav class="post-back">
      <a href="/articles">← 返回</a>
      {collectionInfo ? (
        <a href={`/collections/${collectionInfo.slug}`} class="post-back-collection" style={`color:${categoryColors[category]}`}>
          {collectionInfo.title}
        </a>
      ) : (
        <a href={`/${category}`} class="post-back-category" style={`color:${categoryColors[category]}`}>{categoryLabels[category]}</a>
      )}
    </nav>

    <div class="post-cover-wrap">
      <ArticleCover post={post} size="lg" />
    </div>

    <header class="post-header">
      <div class="post-meta">
        <span class="post-category" style={`color:${categoryColors[category]}`}>{categoryLabels[category]}</span>
        {series && <span class="post-series">{seriesText}</span>}
        <span class="post-date">{dateStr}</span>
        <span class="post-stats">· 约 {wordCount} 字 · 预计阅读时间 {readingTime} 分钟</span>
      </div>
      <h1 class="post-title">{title}</h1>
      {subtitle && <p class="post-subtitle">{subtitle}</p>}
    </header>

    <div class="post-content">
      <Content />
    </div>

    {(prevPost || nextPost) && (
      <nav class="post-nav">
        {prevPost ? (
          <a href={`/posts/${prevPost.slug}`} class="post-nav-item post-nav-prev">
            <span class="post-nav-label">上一篇</span>
            <span class="post-nav-title">{prevPost.data.title}</span>
            <span class="post-nav-date">{prevPost.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </a>
        ) : <span class="post-nav-item post-nav-placeholder" />}
        {nextPost ? (
          <a href={`/posts/${nextPost.slug}`} class="post-nav-item post-nav-next">
            <span class="post-nav-label">下一篇</span>
            <span class="post-nav-title">{nextPost.data.title}</span>
            <span class="post-nav-date">{nextPost.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </a>
        ) : <span class="post-nav-item post-nav-placeholder" />}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .post-back {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    font-family: var(--font-serif);
    font-size: 13px;
  }

  .post-back a {
    color: var(--muted);
    transition: color 0.15s;
  }

  .post-back a:hover {
    color: var(--ink);
  }

  .post-back-category,
  .post-back-collection {
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .post-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 0 64px;
  }

  .post-cover-wrap {
    margin-bottom: 28px;
  }

  .post-cover-wrap :global(.cover) {
    height: auto;
    aspect-ratio: 2 / 1;
    border-radius: 8px;
  }

  .post-header {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin-bottom: 18px;
    font-family: var(--font-serif);
    font-size: 12px;
  }

  .post-category {
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .post-series {
    color: var(--muted);
    font-style: italic;
  }

  .post-date {
    color: var(--muted);
  }

  .post-stats {
    color: var(--muted);
    font-style: italic;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .post-subtitle {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--muted);
    margin-top: 10px;
    font-style: italic;
  }

  .post-content {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 2.2;
    color: var(--text);
  }

  .post-content h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
    margin: 56px 0 32px;
    letter-spacing: -0.005em;
  }

  .post-content h3 {
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    margin: 40px 0 28px;
  }

  .post-content p {
    margin-bottom: 28px;
  }

  .post-content strong {
    font-weight: 600;
    color: var(--ink);
  }

  .post-content blockquote {
    border-left: 3px solid var(--line);
    padding: 4px 0 4px 18px;
    margin: 24px 0;
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--muted);
    font-style: italic;
  }

  .post-content ul, .post-content ol {
    padding-left: 22px;
    margin-bottom: 18px;
  }

  .post-content li {
    margin-bottom: 10px;
  }

  .post-content code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--soft);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 22px 0;
    font-size: 14px;
  }

  .post-content th, .post-content td {
    border-bottom: 1px solid var(--line);
    padding: 8px 12px;
    text-align: left;
  }

  .post-content th {
    font-weight: 600;
    color: var(--ink);
  }

  .post-nav {
    display: flex;
    gap: 16px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .post-nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .post-nav-item:hover {
    opacity: 0.7;
  }

  .post-nav-placeholder {
    visibility: hidden;
  }

  .post-nav-next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav-label {
    font-family: var(--font-serif);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .post-nav-title {
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
  }

  .post-nav-date {
    font-family: var(--font-serif);
    font-size: 11px;
    color: var(--muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .post-article {
      padding: 20px 0 48px;
    }

    .post-title {
      font-size: 23px;
    }

    .post-content {
      font-size: 15px;
      line-height: 1.85;
    }

    .post-cover-wrap :global(.cover) {
      height: auto;
      aspect-ratio: 2 / 1;
    }

    .post-nav {
      flex-direction: column;
      gap: 12px;
    }

    .post-nav-next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
